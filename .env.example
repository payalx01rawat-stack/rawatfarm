# Required by API startup/configuration. REDIS_URL is schema-required but the API
# request path does not connect to Redis; see docs/production-deployment.md.
DATABASE_URL=
REDIS_URL=
JWT_SECRET=

# Optional: defaults are documented in docs/farmmitra-aws-development.md
NODE_ENV=
API_PORT=
JWT_EXPIRES_IN=
CORS_ALLOWED_ORIGINS=
API_BASE_URL=
NEXT_PUBLIC_API_BASE_URL=
MAX_REQUEST_BODY_BYTES=1048576
RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
PAYMENT_RATE_LIMIT_MAX=60
TRUST_PROXY=false
FRONTEND_ORIGIN=
AWS_REGION=
AWS_S3_BUCKET=
FIREBASE_PROJECT_ID=
